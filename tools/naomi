def cmd_blackbox(args):
    """Разбор «чёрного ящика» (device/blackbox.py): записи за последние часы и что в них растёт."""
    hours = float(args[0]) if args else 24
    since = time.time() - hours * 3600
    raw = ssh_run("cat /userdata/naomi/blackbox/*.jsonl 2>/dev/null", capture=True, check=False).stdout
    rows = []
    for line in raw.splitlines():
        try:
            r = json.loads(line)
        except json.JSONDecodeError:
            continue
        if r.get("t", 0) >= since:
            rows.append(r)
    if not rows:
        die("записей нет: служба naomi-blackbox не стоит? (tools/naomi install)")
    os.makedirs(REPORTS, exist_ok=True)
    out = os.path.join(REPORTS, f"blackbox-{time.strftime('%Y%m%d-%H%M%S')}.jsonl")
    with open(out, "w") as f:
        f.write("\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\n")

    def hm(t):
        return time.strftime("%d.%m %H:%M", time.localtime(t))

    span = (rows[-1]["t"] - rows[0]["t"]) / 3600
    print(f"чёрный ящик: {hm(rows[0]['t'])} — {hm(rows[-1]['t'])} ({span:.1f} ч), записей {len(rows)} → "
          f"{os.path.relpath(out, ROOT)}")
    boots = [r for a, r in zip(rows, rows[1:]) if r["up"] < a["up"]]
    gaps = [(a, r) for a, r in zip(rows, rows[1:]) if r["t"] - a["t"] > 150 and r["up"] >= a["up"]]
    print(f"перезагрузок телефона: {len(boots)}" + (": " + ", ".join(hm(r["t"]) for r in boots) if boots else "")
          + (f"; пропусков записи дольше 2,5 мин: {len(gaps)} (" + ", ".join(hm(a["t"]) for a, _ in gaps[:5]) + ")"
             if gaps else ""))
    names = {"shell": "оболочка", "naomid": "naomid", "web": "браузер", "pulse": "PulseAudio", "sshd": "sshd"}
    for key, title in names.items():
        seq = [(r["t"], r["p"][key]) for r in rows if key in r.get("p", {})]
        if not seq:
            print(f"{title}: не запускался")
            continue
        if key == "sshd":   # процессов много, свой pid у каждого входа — перезапуски не считаем
            restarts, last = [], seq
            line = f"{title}: процессов до {max(p['n'] for _, p in seq)}"
        else:
            restarts = [t for (_, a), (t, b) in zip(seq, seq[1:]) if a["pid"] != b["pid"]]
            # последний непрерывный отрезок (один и тот же процесс): на нём и смотреть рост
            last = [(t, p) for t, p in seq if p["pid"] == seq[-1][1]["pid"]]
            line = f"{title}: перезапусков {len(restarts)}" + (" (" + ", ".join(hm(t) for t in restarts[-4:]) + ")"
                                                               if restarts else "")
        dur = (last[-1][0] - last[0][0]) / 3600
        line += f"; работает {dur:.1f} ч"
        for field, unit in (("rss", "МБ"), ("thr", "потоков"), ("fd", "файлов"), ("sock", "сокетов"),
                            ("dmabuf", "dma-buf"), ("audio", "захватов звука")):
            v = [p[field] for _, p in last if field in p]
            if not v:
                continue
            line += f"; {unit} {v[0]} → {v[-1]}" + (f" (от {min(v)} до {max(v)})"
                                                    if min(v) != min(v[0], v[-1]) or max(v) != max(v[0], v[-1]) else "")
            if dur >= 0.5 and len(v) >= 20 and field in ("rss", "thr", "fd", "sock"):
                # рост — медиана второй половины отрезка против первой
                h = len(v) // 2
                a, b = sorted(v[:h])[h // 2], sorted(v[h:])[(len(v) - h) // 2]
                if b > a * 1.15 + 2:
                    line += f" — РАСТЁТ: +{(b - a) / (dur / 2):.0f} в час"
        cpu = [p["cpu"] for _, p in last if "cpu" in p]
        if cpu:
            line += f"; процессор в среднем {sum(cpu) / len(cpu):.1f} %"
        print(line)
    avail = [r["mem"]["avail"] for r in rows]
    print(f"память: доступно {avail[-1]} МБ (наименьшее за период {min(avail)}); потоков в системе до "
          f"{max(r['n']['threads'] for r in rows)}")
    skin = [r["temp"].get("skin", 0) for r in rows]
    hot = [r for r in rows if r.get("cool")]
    print(f"тепло: корпус до {max(skin):.1f} °C, сейчас {skin[-1]:.1f}; минут с ограничителями: {len(hot)}"
          + (" (наибольшие ступени: " + ", ".join(f"{k} {max(r['cool'].get(k, 0) for r in hot)}"
                                                 for k in sorted({k for r in hot for k in r["cool"]})) + ")"
             if hot else ""))
    for on, title in ((True, "стол смотрят"), (False, "стола нет")):
        w = [r["power"]["usb_w"] for r in rows if r.get("desk") == on]
        if w:
            print(f"мощность от кабеля, {title}: {sum(w) / len(w):.2f} Вт в среднем, до {max(w):.2f} ({len(w)} мин)")
    if "disk_free_mb" in rows[-1]:
        print(f"место на /userdata: {rows[-1]['disk_free_mb'] / 1024:.1f} ГБ свободно")


