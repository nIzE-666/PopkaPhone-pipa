def cmd_mouse(args):
    """Проверочная мышь стола: действия → вызовы org.naomi.DeskTest.Pointer одной пачкой на телефоне (gdbus)."""
    if not ssh_ok():
        die("нужен SSH (tools/naomi access)")
    call = ("gdbus call --session --dest org.naomi.DeskTest --object-path /input "
            "--method org.naomi.DeskTest.Pointer {b} {x:.4f} {y:.4f} >/dev/null")
    lines, buttons, x, y, i = [], 0, 0.5, 0.5, 0
    toks = " ".join(args).split()
    def num():
        nonlocal i
        i += 1
        return float(toks[i - 1])
    while i < len(toks):
        t = toks[i]
        i += 1
        if t == "abs":
            x, y = num(), num()
        elif t == "press":
            buttons |= 1
        elif t == "release":
            buttons &= ~1
        elif t == "shift":
            buttons |= 16
        elif t == "noshift":
            buttons &= ~16
        elif t == "wait":
            lines.append(f"sleep {num()}")
            continue
        elif t == "drag":   # к X Y за СЕК, шагами по 1/60 с
            tx, ty, sec = num(), num(), num()
            n = max(1, int(sec * 60))
            for k in range(1, n + 1):
                lines.append(call.format(b=buttons, x=x + (tx - x) * k / n, y=y + (ty - y) * k / n))
                lines.append("sleep 0.0166")
            x, y = tx, ty
            continue
        else:
            die(f"не понял «{t}»: abs X Y, press, release, shift, noshift, drag X Y СЕК, wait СЕК")
        lines.append(call.format(b=buttons, x=x, y=y))
    ssh_run("export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/32011/bus; " + "; ".join(lines))


