# Словари клавиатуры (docs/KEYBOARD.md): частоты слов из субтитров OpenSubtitles 2018 — проект FrequencyWords
# (hermitdave, CC BY-SA 4.0), в git не лежат. Нет в downloads/dict — скачиваются; SHA-256 сверяется.
DICT_RAW = "https://raw.githubusercontent.com/hermitdave/FrequencyWords/master/content/2018"
DICTS = {   # язык: файл, SHA-256, буквы (порядок = номера букв в дереве), не реже скольких раз
    "ru": ("ru_full.txt", "32dfd94138aea2667ec455dcc8512029e39bd4b8ea70b09410d569b69d511a30",
           "абвгдеёжзийклмнопрстуфхцчшщъыьэюя-", 3),
    "en": ("en_50k.txt", "5351ff405b1126ef555791dd4d9798a48e3e9a501a9fc481a9da957752cfb458",
           "abcdefghijklmnopqrstuvwxyz'-", 1),
}


def build_dict(path, alphabet, min_count):
    """Список «слово частота» → дерево слов (shell/input/spell.h, «Словарь»): узлы в порядке обхода в ширину,
    дети узла подряд. Узел — 8 байт: первый ребёнок u32, детей u8, буква u8, частота слова u8 (0 — не слово),
    лучшая частота в поддереве u8. Частота — логарифм числа встреч, сжатый в 1…255."""
    import math
    import struct
    index = {c: i for i, c in enumerate(alphabet)}
    counts = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) != 2:
                continue
            w, c = parts[0].lower(), int(parts[1])
            if c < min_count or not 0 < len(w) <= 24 or w[0] in "-'" or w[-1] in "-'":
                continue
            if all(ch in index for ch in w):
                counts[w] = counts.get(w, 0) + c
    words = sorted((tuple(index[ch] for ch in w), c) for w, c in counts.items())
    lo_ln, hi_ln = math.log(min(counts.values())), math.log(max(counts.values()))
    total_ln = math.log(sum(counts.values()))
    q = lambda c: 1 + round(254 * (math.log(c) - lo_ln) / (hi_ln - lo_ln))
    first, nkids, letter, freq = [0], [0], [0], [0]
    queue = [(0, 0, 0, len(words))]   # узел, глубина, слова [lo, hi)
    head = 0
    while head < len(queue):
        node, depth, lo, hi = queue[head]
        head += 1
        if lo < hi and len(words[lo][0]) == depth:   # слово кончается здесь (короткие — первыми)
            freq[node] = q(words[lo][1])
            lo += 1
        first[node] = len(first)
        i = lo
        while i < hi:
            ch = words[i][0][depth]
            j = i
            while j < hi and words[j][0][depth] == ch:
                j += 1
            first.append(0)
            nkids.append(0)
            letter.append(ch)
            freq.append(0)
            queue.append((len(first) - 1, depth + 1, i, j))
            nkids[node] += 1
            i = j
    best = list(freq)
    for node in range(len(first) - 1, -1, -1):
        for k in range(first[node], first[node] + nkids[node]):
            best[node] = max(best[node], best[k])
    abc = alphabet.encode("utf-32-le")
    out = [b"NDIC", struct.pack("<IIIfff", 1, len(first), len(alphabet), lo_ln, hi_ln, total_ln), abc]
    out += [struct.pack("<IBBBB", first[n], nkids[n], letter[n], freq[n], best[n]) for n in range(len(first))]
    return b"".join(out), len(words), len(first)


