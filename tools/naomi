def cmd_access():
    need_device()
    if not os.path.isfile(SSH_KEY):   # свой ключ для телефона и приставки: лежит в private/ssh, в git не идёт
        os.makedirs(SSH_DIR, mode=0o700, exist_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "naomiphone", "-f", SSH_KEY], check=True)
        print(f"создан ключ {SSH_KEY}")
    key = open(SSH_KEY + ".pub").read().strip()
    adb("shell", f"umask 077; mkdir -p ~/.ssh; grep -qxF '{key}' ~/.ssh/authorized_keys 2>/dev/null"
                 f" || echo '{key}' >> ~/.ssh/authorized_keys")
    adb("push", os.path.join(ROOT, "device", "dev-access.sh"), "/tmp/naomi-dev-access.sh")
    if ssh_ok():
        print("SSH по ключу уже работает: tools/naomi ssh")
    else:
        print("ключ на телефоне. Осталось один раз (пароль телефона вводит пользователь):\n"
              "  adb shell -t sudo sh /tmp/naomi-dev-access.sh")


