def cmd_touchtest():
    """Виртуальный палец ведёт круг 3 с (180 Гц, как сенсор); счётчики оболочки (NAOMI_TRACE)
    показывают, сколько касаний пришло между соседними кадрами. Норма — ни одного кадра без касания."""
    if not ssh_ok():
        die("нужен SSH (tools/naomi access)")
    push(os.path.join(ROOT, "device", "touchinject.py"), f"{PHONE}/bin/touchinject.py")
    os.environ["NAOMI_RUN_ENV"] = "NAOMI_TRACE=1"
    cmd_run([])
    time.sleep(3)
    log = ssh_run(f"S=$(date '+%Y-%m-%d %H:%M:%S'); sudo -n python3 {PHONE}/bin/touchinject.py circle 3 "
                  "2>/dev/null; sleep 1.2; journalctl -u naomi-shell --since \"$S\" --no-pager -o cat",
                  capture=True).stdout
    import re
    frames = [0] * 5
    for line in log.splitlines():
        m = re.search(r"касаний (\d+) .*0/1/2/3/4\+ касаниями: (\d+)/(\d+)/(\d+)/(\d+)/(\d+)", line)
        if m and int(m[1]) >= 150:          # целая секунда внутри жеста
            frames = [a + int(b) for a, b in zip(frames, m.groups()[1:])]
        if line.startswith(("naomi-trace", "naomi-frames")):
            print(" ", line)
    total = sum(frames)
    if not total:
        die("счётчики не увидели касаний (оболочка не подхватила виртуальный палец?)")
    empty = frames[0] / total
    print(f"кадров с 0/1/2/3/4+ касаниями: {'/'.join(map(str, frames))} — "
          + ("ровно: каждый кадр получает касания" if empty < 0.05 else
             f"РЫВКИ: {empty:.0%} кадров без касаний"))
    os.environ["NAOMI_RUN_ENV"] = ""
    cmd_run([])


