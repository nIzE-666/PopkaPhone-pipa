#!/usr/bin/env python3
"""НаомиФон — команды с Mac для работы с телефоном.

  tools/naomi probe [раздел …]   опись телефона → reports/probe-*.json и краткая сводка
  tools/naomi test [тест …]      живые тесты железа (device/hwtest.py) → reports/hwtest-*.json,
                                 снимки камер → reports/camera/
  tools/naomi stress [нагр] [ост]  нагрев: все ядра CPU на нагр с (60), остывание ост с (30)
                                 → reports/stress-*.json
  tools/naomi gamesoak [сек] [пакет] [имя]  долгий замер приложения Android на столе (device/gamesoak.py, 600 с):
                                 кадры приложения и стола, мощность, нагрев, ограничители, частоты, кто сколько ест
                                 → reports/gamesoak-имя-*.csv и .json
  tools/naomi build              отправить shell/ на телефон (~/naomi/src) и собрать в среде сборки
                                 (device/devroot.sh) → ~/naomi/build
  tools/naomi install [uninstall]  поставить службы оболочки в систему: автозапуск, безопасный
                                 режим, кнопка питания (device/install-shell.sh)
  tools/naomi setup              всё после прошивки и доступа одной командой (docs/INSTALL.md): кабель, среда
                                 сборки, сборка, службы, выключить Lomiri, шрифты, словари, фильтры, запуск
  tools/naomi devroot            среда сборки на телефоне (device/devroot.sh): копия корня (≈ 3,3 ГБ на телефоне)
                                 и пакеты сборки (≈ 175 МБ скачивания); уже есть — не трогает
  tools/naomi lomiri [off|on]    штатная оболочка Lomiri: выключить / вернуть (device/lomiri.sh); без слова — состояние
  tools/naomi run [сек]          перезапустить оболочку (служба naomi-shell); с числом — показать
                                 журнал столько секунд; NAOMI_RUN_ENV="K=V …" — добавить
                                 окружение (например NAOMI_TRACE=1)
  tools/naomi stop               остановить оболочку
  tools/naomi shot [desk] [имя]  снимок экрана оболочки (desk — последний кадр рабочего стола) → reports/screens/
  tools/naomi mouse ДЕЙСТВИЯ     проверочная мышь стола — как от зрителя, без приставки (docs/STREAM.md, «Проверочная
                                 мышь»; стол должен смотреть зритель): abs X Y (доли стола), press / release, shift /
                                 noshift, drag X Y СЕК (протащить отсюда), wait СЕК
  tools/naomi screens [ЭКРАН off|on|main | desk on|off | wake ЭКРАН | light ЭКРАН auto|ПРОЦЕНТ]
                                 «Экраны» (docs/SCREENS.md): что на связи и что показывает; положение экрана
                                 (заставка, стол, главный), выключатель стола, жест пробуждения на экране, яркость
                                 экрана планшета — как из «Настроек» и окна стола, без пальца
  tools/naomi panel [сек]        как дисплей кладёт кадр на панель (журнал драйвера): смеситель, слои —
                                 из кадра → на экран; ждёт кадра до сек (70: в AOD кадр раз в минуту)
  tools/naomi touchtest          проверка плавности касаний: виртуальный палец + счётчики кадров
  tools/naomi ssh [команда]      SSH на телефон, ключ — private/ssh
  tools/naomi shell [команда]    оболочка на телефоне через ADB (без SSH)
  tools/naomi access             первичная настройка доступа: ключ компьютера (нет — создаёт в private/ssh)
                                 на телефон и скрипт device/dev-access.sh в /tmp (его запускают один раз через sudo)
  tools/naomi usb [install|uninstall]  кабель разработчика: ADB и сеть по USB всегда, на кабеле приставка — интернет
                                 через неё (device/naomi-usb, docs/PI.md); без слова — что сейчас на кабеле
  tools/naomi phone              служба железа naomid: все объекты и их значения (docs/NAOMID.md)
  tools/naomi blackbox [часов]   «чёрный ящик» (docs/XRAY.md): что было с телефоном за последние часы (24) по записи
                                 раз в минуту — перезагрузки и перезапуски служб, рост памяти, потоков и открытых
                                 файлов оболочки и браузера, тепло и ограничители, мощность → reports/blackbox-*.jsonl
  tools/naomi fonts              шрифты и значки интерфейса (docs/UI.md) → телефон (~/.local/share/fonts/naomi):
                                 чего нет в downloads/fonts — скачивает с GitHub (≈ 20 МБ), сверяет SHA-256
  tools/naomi android [init|tune|status]  Android-приложения (Waydroid, docs/ANDROID.md; device/android-setup.sh):
                                 init — образы с Google Play (~1,37 ГБ с SourceForge; уже есть — не качает) и
                                 свойства, tune — настройки внутри Android (нужен включённый Android), status
  tools/naomi cores [status]     ядра эмуляторов «Игр» стола (docs/GAMES.md; device/cores.sh): скачать исходники
                                 закреплённой версии с GitHub на телефон (Mesen — ~40 МБ) и собрать в среде сборки
                                 → ~/naomi/cores; уже скачано — не качает
  tools/naomi wine [status]      программы Windows на столе (docs/WINDOWS.md; device/wine.sh): скрипты → ~/naomi/bin,
                                 скачать Wine, DXVK и исходники Box64 и Mesa (≈ 250 МБ), собрать Box64 и драйвер
                                 Vulkan Turnip в среде сборки (десятки минут); status — что уже есть
  tools/naomi claude [install|status]  Claude Desktop для Linux на столе (docs/CLAUDE.md; device/claude.sh):
                                 новейший пакет arm64 из репозитория Anthropic (≈ 185 МБ, подпись и SHA-256
                                 сверяются) → ~/naomi/opt/claude-desktop; status — что стоит и что новейшее
  tools/naomi dict               словари клавиатуры (docs/KEYBOARD.md): частоты слов (нет в downloads/dict —
                                 скачивает с GitHub, ≈ 30 МБ, сверяет SHA-256) → дерево слов → телефон
                                 (~/.local/share/naomi/dict)
  tools/naomi web-filters        блокировка рекламы и слежки в «Браузере» (docs/WEB.md): EasyList и EasyPrivacy
                                 (нет в downloads/filters — скачивает с easylist.to, ≈ 5 МБ) → доменные правила →
                                 телефон (~/.local/share/naomi/web/filters.txt)
  tools/naomi desktop-wallpaper файл [имя]  обои рабочего стола (docs/DESKTOP.md) → телефон: в собрание
                                 «Настроек» → «Обои» (~/.config/naomi/desktop/wallpapers/имя) и на стол
                                 (wallpaper.jpg)

Связь (первое, что отвечает): сеть по кабелю — SSH на 10.77.0.1 (служба naomi-usb); ADB — SSH через
`adb forward` на порт 22 телефона; Wi-Fi — на адрес из private/device.json (его запоминает каждая связь
по кабелю) или из NAOMI_HOST; Wi-Fi молчит — через приставку, у которой телефон на кабеле (SSH на
NAOMI_PI_HOST или naomi-pi.local, оттуда на 10.77.0.1). NAOMI_VIA=cable|adb|wifi|pi — только этот путь. Ключ хоста один и тот же,
закреплён в private/ssh/known_hosts.
Разделы описи — device/probe.py (SECTIONS).
"""
import json
import os
import shlex
import socket
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPORTS = os.path.join(ROOT, "reports")
SSH_DIR = os.path.join(ROOT, "private", "ssh")
SSH_KEY = os.path.join(SSH_DIR, "naomiphone_ed25519")
SSH_PORT = 40022  # порт Mac, проброшенный через ADB на порт 22 телефона
CABLE_HOST = "10.77.0.1"  # телефон в сети по кабелю (device/naomi-usb)
DEVICE_JSON = os.path.join(ROOT, "private", "device.json")


def die(msg):
    print(f"\033[1;31m✗ {msg}\033[0m", file=sys.stderr)
    sys.exit(1)


def fetch(url, path, sha=None):
    """Файл, которого нет, — скачать (curl): пишет, что и откуда; sha — сверить SHA-256 (не та — файл убрать)."""
    import hashlib
    if not os.path.isfile(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        print(f"скачиваю {os.path.basename(path)} ← {url}", flush=True)
        if subprocess.run(["curl", "-sSfL", "--retry", "2", "-o", path + ".part", url]).returncode:
            if os.path.exists(path + ".part"):
                os.remove(path + ".part")
            die(f"не скачалось: {url}")
        os.replace(path + ".part", path)
    if sha:
        with open(path, "rb") as f:
            got = hashlib.sha256(f.read()).hexdigest()
        if got != sha:
            die(f"не та сумма SHA-256: {path} (ждали {sha}, вышло {got}) — удалите файл и повторите")


def adb(*args, capture=True, check=True):
    p = subprocess.run(["adb", *args], capture_output=capture, text=True)
    if check and p.returncode != 0:
        die(f"adb {' '.join(args)}: {(p.stderr or p.stdout).strip()}")
    return p.stdout if capture else p.returncode


def adb_device():
    """Серийный номер единственного телефона в ADB или None. Другие устройства Android (планшет — docs/TABLET.md)
    — мимо: телефон называет себя device:redfin (getprop ro.product.device и под Ubuntu Touch)."""
    out = adb("devices", "-l", check=False) or ""
    devs = []
    for l in out.splitlines()[1:]:
        f = l.split()
        if len(f) < 2 or f[1] != "device":
            continue
        name = next((x.split(":", 1)[1] for x in f[2:] if x.startswith("device:")), None)
        if name in (None, "redfin"):
            devs.append(f[0])
    if len(devs) > 1:
        die(f"в ADB несколько устройств: {devs}")
    return devs[0] if devs else None


def need_device():
    dev = adb_device()
    if not dev:
        die("телефон не виден в ADB: режим USB без ADB или кабель не подключён "
            "(tools/flash.sh status — что с ним)")
    return dev


def device_info():
    try:
        with open(DEVICE_JSON) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


_route = None


def cable_up():
    """Отвечает ли SSH телефона в сети по кабелю."""
    try:
        socket.create_connection((CABLE_HOST, 22), timeout=0.7).close()
        return True
    except OSError:
        return False


def answers(host):
    """Отвечает ли SSH по этому адресу."""
    try:
        socket.create_connection((host, 22), timeout=2).close()
        return True
    except OSError:
        return False


PI_HOST = os.environ.get("NAOMI_PI_HOST", "naomi-pi.local")   # приставка: телефон у неё на кабеле — 10.77.0.1


def route():
    """Как дойти до SSH телефона: ('cable', host, 22), ('adb', 127.0.0.1, порт) или ('wifi', host, 22)."""
    global _route
    if _route:
        return _route
    via = os.environ.get("NAOMI_VIA")
    if via in (None, "cable") and cable_up():
        _route = ("cable", CABLE_HOST, 22)
    elif via in (None, "adb") and adb_device():
        adb("forward", f"tcp:{SSH_PORT}", "tcp:22")
        _route = ("adb", "127.0.0.1", SSH_PORT)
    elif via in (None, "wifi", "pi"):
        host = os.environ.get("NAOMI_HOST") or device_info().get("wifi_ip")
        # Wi-Fi телефона молчит (он не в домашней сети), а телефон — на кабеле у приставки: через неё (docs/PI.md)
        if via == "pi" or (via is None and not (host and answers(host))):
            _route = ("pi", CABLE_HOST, 22)
        elif not host:
            die("по кабелю телефона не видно, а адрес Wi-Fi неизвестен")
        else:
            _route = ("wifi", host, 22)
    else:
        die(f"NAOMI_VIA={via}: этим путём телефона не видно")
    return _route


def ssh_argv(*remote, tty=False):
    """Команда ssh на телефон: по кабелю через ADB-туннель, иначе по Wi-Fi."""
    via, host, port = route()
    first = not os.path.exists(os.path.join(SSH_DIR, "known_hosts"))
    jump = []
    if via == "pi":   # через приставку: её SSH пробрасывает соединение на телефон по кабелю
        jump = ["-o", f"ProxyCommand=ssh -i {shlex.quote(SSH_KEY)} -o IdentitiesOnly=yes -o BatchMode=yes "
                      f"-o ConnectTimeout=8 -o UserKnownHostsFile={shlex.quote(os.path.join(SSH_DIR, 'known_hosts_pi'))} "
                      f"naomi@{PI_HOST} -W {CABLE_HOST}:22"]
    return ["ssh", "-i", SSH_KEY, "-p", str(port), *jump,
            "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
            # оборванную связь (кабель переподключился) замечать за ~6 с, а не висеть
            "-o", "ServerAliveInterval=2", "-o", "ServerAliveCountMax=3",
            "-o", f"UserKnownHostsFile={os.path.join(SSH_DIR, 'known_hosts')}",
            "-o", "HostKeyAlias=naomiphone",
            "-o", "StrictHostKeyChecking=" + ("accept-new" if first else "yes"),
            *(["-t"] if tty else []), f"phablet@{host}", *remote]


def ssh_ok():
    p = subprocess.run(ssh_argv("true"), capture_output=True, text=True)
    if p.returncode == 0 and route()[0] != "wifi":
        remember_wifi()
    return p.returncode == 0


def remember_wifi():
    """Запомнить адрес Wi-Fi телефона — для связи, когда кабеля нет."""
    p = subprocess.run(ssh_argv("ip -4 -o addr show wlan0"), capture_output=True, text=True)
    parts = p.stdout.split()
    ip = parts[parts.index("inet") + 1].split("/")[0] if "inet" in parts else None
    info = device_info()
    if ip and info.get("wifi_ip") != ip:
        info["wifi_ip"] = ip
        os.makedirs(os.path.dirname(DEVICE_JSON), exist_ok=True)
        with open(DEVICE_JSON, "w") as f:
            json.dump(info, f, indent=1)


def push(local, remote):
    """Скопировать файл на телефон: по SSH (кабель или Wi-Fi), если он есть, иначе через ADB."""
    if ssh_ok():
        with open(local, "rb") as f:
            p = subprocess.run(ssh_argv(f"cat > {remote}"), stdin=f, capture_output=True)
        if p.returncode != 0:
            die(f"не скопировать {local}: {p.stderr.decode().strip()}")
        return True
    need_device()
    adb("push", local, remote)
    return False


def summary(r):
    def g(*path, default="—"):
        cur = r
        for p in path:
            if not isinstance(cur, dict) or p not in cur:
                return default
            cur = cur[p]
        return cur

    out = []
    s = r.get("system", {})
    if s:
        mem = s.get("meminfo_kb", {})
        out.append(f"система   {s.get('os')} · {(s.get('uname') or '').split()[2:3]} · "
                   f"RAM {mem.get('MemAvailable', 0)//1024}/{mem.get('MemTotal', 0)//1024} МиБ свободно")
    for p in g("cpu", "policies", default=[]):
        out.append(f"CPU {p['cpus']:<8} {p['governor']:<11} {p['cur_khz']//1000 if isinstance(p['cur_khz'], int) else '?'} МГц"
                   f" (до {p['hw_max_khz']//1000 if isinstance(p['hw_max_khz'], int) else '?'})")
    if "gpu" in r:
        out.append(f"GPU       {g('gpu', 'gpu_model')} · {g('gpu', 'gpuclk')} Гц · "
                   f"частоты {g('gpu', 'gpu_available_frequencies')}")
    zones = g("thermal", "zones", default=[])
    if zones:
        # настоящие температуры в миллиградусах; «soc», «*-lvl*» и −273° — не температуры
        real = {z["type"]: z["temp"] / 1000 for z in zones
                if isinstance(z["temp"], int) and 0 < z["temp"] < 150000 and z["type"] != "soc"
                and "-lvl" not in z["type"]}
        key = [k for k in ("skin-therm", "cpu-1-max-step", "gpuss-max-step", "battery", "disp-therm")
               if k in real]
        hottest = max(real, key=real.get) if real else None
        out.append("тепло     " + ", ".join(f"{k} {real[k]:.1f}°" for k in key)
                   + (f" · горячее всех {hottest} {real[hottest]:.1f}°" if hottest else "")
                   + f" (зон {len(zones)})")
    bat = g("power", "supplies", "battery", default={})
    if bat:
        out.append(f"батарея   {bat.get('capacity')}% {bat.get('status')} · "
                   f"{int(bat.get('current_now', 0))/1000:.0f} мА · {int(bat.get('voltage_now', 0))/1e6:.2f} В · "
                   f"{int(bat.get('temp', 0))/10:.1f}°")
    for c in g("display", "drm", default=[]):
        if c.get("modes") and "Virtual" not in c["connector"]:
            out.append(f"дисплей   {c['connector']} {c['status']} · режимы {', '.join(c['modes'])}")
    svc = r.get("services", {})
    if svc:
        out.append(f"службы    работают {len(svc.get('running', []))}, упали: {svc.get('failed') or 'нет'}; "
                   f"пользователя: {len(svc.get('user_running', []))}, упали: {svc.get('user_failed') or 'нет'}")
    a = r.get("android", {})
    if a:
        out.append(f"Android   служб работает {len(a.get('services_running', []))}")
    for key in ("modem", "bluetooth", "audio", "sensors"):
        if key in r:
            v = r[key]
            if key == "modem":
                out.append(f"модем     {v.get('modems') or v.get('error')}")
            elif key == "bluetooth":
                out.append(f"bluetooth {v.get('hci')}")
            elif key == "audio":
                out.append(f"звук      выходов {len(v.get('sinks', []))}, входов {len(v.get('sources', []))}")
            elif key == "sensors":
                out.append(f"датчики   sensorfw: {v.get('sensorfw_plugins') or v.get('sensorfw_raw')}")
    errs = [k for k, v in r.items() if isinstance(v, dict) and "error" in v]
    if errs:
        out.append(f"ошибки в разделах: {errs}")
    return "\n".join(out)


def cmd_probe(sections):
    via_ssh = push(os.path.join(ROOT, "device", "probe.py"), "/tmp/naomi-probe.py")
    t = time.time()
    if via_ssh:
        p = subprocess.run(ssh_argv("python3", "/tmp/naomi-probe.py", *sections),
                           capture_output=True, text=True)
        out = p.stdout
    else:
        out = adb("shell", "python3", "/tmp/naomi-probe.py", *sections)
    try:
        report = json.loads(out)
    except json.JSONDecodeError:
        die("опись вернула не JSON:\n" + out[-2000:])
    os.makedirs(REPORTS, exist_ok=True)
    path = os.path.join(REPORTS, time.strftime("probe-%Y%m%d-%H%M%S.json"))
    with open(path, "w") as f:
        json.dump(report, f, ensure_ascii=False, indent=1)
    print(summary(report))
    print(f"\nполная опись: {os.path.relpath(path, ROOT)} ({time.time() - t:.1f} с)")


STATUS_MARK = {"ok": "\033[32m✓ работает\033[0m", "partial": "\033[33m◐ частично\033[0m",
               "fail": "\033[31m✗ не работает\033[0m", "manual": "\033[36m? проверь сам\033[0m",
               "skip": "\033[90m— пропущен\033[0m"}


def cmd_test(names):
    if not ssh_ok():
        die("нужен SSH (tools/naomi access)")
    subprocess.run(ssh_argv("mkdir -p /tmp/naomi-qml"), check=True)
    push(os.path.join(ROOT, "device", "hwtest.py"), "/tmp/naomi-hwtest.py")
    qml_dir = os.path.join(ROOT, "device", "qml")
    for f in sorted(os.listdir(qml_dir)):
        push(os.path.join(qml_dir, f), f"/tmp/naomi-qml/{f}")
    p = subprocess.run(ssh_argv("python3", "/tmp/naomi-hwtest.py", *names),
                       stdout=subprocess.PIPE, text=True)  # ход теста (stderr) — сразу на экран
    try:
        report = json.loads(p.stdout)
    except json.JSONDecodeError:
        die("тест вернул не JSON:\n" + p.stdout[-2000:])
    os.makedirs(REPORTS, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    path = os.path.join(REPORTS, f"hwtest-{stamp}.json")
    with open(path, "w") as f:
        json.dump(report, f, ensure_ascii=False, indent=1)
    cam = report["results"].get("camera", {}).get("details", {}).get("shots", {})
    if cam:
        os.makedirs(os.path.join(REPORTS, "camera"), exist_ok=True)
    for idx, shot in cam.items():
        local = os.path.join(REPORTS, "camera", f"{stamp}-cam{idx}.jpg")
        with open(local, "wb") as f:
            subprocess.run(ssh_argv(f"cat {shot['file']}"), stdout=f, check=True)
    print()
    for name, r in report["results"].items():
        print(f"{name:<10} {STATUS_MARK.get(r['status'], r['status'])}  {r['summary']}")
    print(f"\nотчёт: {os.path.relpath(path, ROOT)}")


def cmd_stress(args):
    if not ssh_ok():
        die("нужен SSH (tools/naomi access)")
    push(os.path.join(ROOT, "device", "stress.py"), "/tmp/naomi-stress.py")
    p = subprocess.run(ssh_argv("python3", "/tmp/naomi-stress.py", *args), stdout=subprocess.PIPE, text=True)
    try:
        report = json.loads(p.stdout)
    except json.JSONDecodeError:
        die("тест нагрева вернул не JSON:\n" + p.stdout[-2000:])
    os.makedirs(REPORTS, exist_ok=True)
