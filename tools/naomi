def cmd_panel(args):
    """Как дисплей кладёт кадр на панель — по журналу драйвера (sde_evtlog), а не по снимку: снимок рисует сцену
    заново и ошибку составления не видит (16 ноября 2026: смеситель 720 × 1560, на экране угол кадра крупнее)."""
    if not ssh_ok():
        die("нужен SSH (tools/naomi access)")
    wait = float(args[0]) if args else 70   # в AOD кадр — раз в минуту
    # blend_setup_mixer:1484 — строка ядра этого телефона с местом слоя: plane, fb, src x y w h, dst x y w h
    p = ssh_run("sudo -n sh -c 'cd /sys/kernel/tracing && echo 0 > tracing_on && echo > trace && "
                "echo 4096 > buffer_size_kb && echo 1 > events/sde/sde_evtlog/enable && echo 1 > tracing_on; "
                f"for i in $(seq {int(wait * 10)}); do sleep 0.1; grep -q blend_setup_mixer trace && "
                "{ sleep 0.3; break; }; done; echo 0 > tracing_on; echo 0 > events/sde/sde_evtlog/enable; "
                "grep -E \"blend_setup_mixer:1484|program_lm_output_roi|dsc_setup\" trace'",
                check=False, capture=True)
    lm, layers, panel, last = [], [], None, None
    for line in p.stdout.splitlines():
        try:
            ts = float(line.split("sde_evtlog:")[0].split()[-1].rstrip(":"))
            tag, *f = line.split("sde_evtlog:")[1].strip().split("|")[1:]
            f = [int(x, 16) for x in f]
        except (IndexError, ValueError):
            continue
        if last is None or ts - last > 0.002:   # новая сборка кадра
            if "dsc_setup" not in tag:
                lm, layers = ([], layers) if "lm_output" in tag else (lm, [])
        last = ts
        if "lm_output" in tag:
            lm = [x for x in lm if x[0] != f[1]] + [(f[1], f[2], f[3], f[4], f[5])]
        elif "blend_setup" in tag:
            layers.append(f[1:11])
        elif "dsc_setup" in tag:
            panel = (f[4], f[5])
    if not layers or not lm:
        die("кадров не было — экран выключен? (tools/naomi panel [сек] ждёт кадра столько секунд)")
    mw, mh = sum(x[3] for x in lm), max(x[4] for x in lm)
    print(f"смеситель {mw}×{mh} ({len(lm)} × {lm[0][3]})" + (f", панель {panel[0]}×{panel[1]}" if panel else ""))
    fbs = {}
    for plane, fb, sx, sy, sw, sh, dx, dy, dw, dh in layers:
        a = fbs.setdefault(fb, [sx, sy, sx + sw, sy + sh, dx, dy, dx + dw, dy + dh])
        a[:] = [min(a[0], sx), min(a[1], sy), max(a[2], sx + sw), max(a[3], sy + sh),
                min(a[4], dx), min(a[5], dy), max(a[6], dx + dw), max(a[7], dy + dh)]
    for fb, (sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1) in fbs.items():
        print(f"слой (буфер {fb}): из кадра {sx0},{sy0} {sx1 - sx0}×{sy1 - sy0} → в смеситель {dx0},{dy0} "
              f"{dx1 - dx0}×{dy1 - dy0}")
    if panel and (mw, mh) != panel:
        print(f"ВНИМАНИЕ: смеситель меньше панели — дисплей растягивает его целиком; место слоя обрезано по "
              f"{mw}×{mh}")


