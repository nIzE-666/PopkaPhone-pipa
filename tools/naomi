# ---------- реклама и слежка: EasyList, EasyPrivacy → правила для перехватчика браузера (web_filter.cpp) ----------
# Списки — в downloads/filters (нет — скачиваются): https://easylist.to/easylist/easylist.txt и
# https://easylist.to/easylist/easyprivacy.txt (обновляются ежедневно — суммы не сверяются, версия — в заголовке).
# Берутся только правила на целый домен — `||домен^` и `@@||домен^` с понятными условиями; правила с путём, косметика
# (`##`) и правила под отдельные сайты (`domain=` у блокирующих) — нет. Строки результата:
#   b домен [3] [t=типы]   блокировать (3 — только сторонние запросы)
#   a домен [t=типы] [on=сайты]   не блокировать (исключение; on — только на этих сайтах)
#   s домен                не блокировать ничего на страницах этого сайта ($document)
FILTER_TYPES = {"script": "script", "image": "image", "stylesheet": "css", "css": "css", "xmlhttprequest": "xhr",
                "xhr": "xhr", "subdocument": "frame", "frame": "frame", "media": "media", "font": "font",
                "object": "object", "ping": "ping", "websocket": "websocket", "other": "other"}
FILTER_IGNORE = {"important", "match-case"}


def compile_filters(lines):
    import re
    rule = re.compile(r"^(@@)?\|\|([a-z0-9.-]+\.[a-z0-9-]+)\^(?:\$(.*))?$")
    block, allow, site = {}, {}, set()
    for line in lines:
        m = rule.match(line.strip())
        if not m:
            continue
        exception, host, opts = m.group(1) is not None, m.group(2), m.group(3)
        third, types, on, skip, document = False, set(), set(), False, False
        for o in (opts.split(",") if opts else []):
            o = o.strip()
            if o in FILTER_IGNORE:
                continue
            if o in ("third-party", "3p"):
                third = True
            elif o in FILTER_TYPES:
                types.add(FILTER_TYPES[o])
            elif o == "all":
                types.clear()
            elif o == "document" and exception:
                document = True
            elif o.startswith("domain=") and exception:
                on |= {d for d in o[7:].split("|") if d and not d.startswith("~")}
                skip |= not on
            else:
                skip = True   # ~third-party, ~script, domain= у блокирующих, popup, csp, redirect, removeparam…
        if skip:
            continue
        if exception:
            if document and not types and not on:
                site.add(host)
            elif not document:
                r = allow.setdefault(host, {"types": set(), "all": False, "on": set(), "everywhere": False})
                r["all"] |= not types
                r["types"] |= types
                r["everywhere"] |= not on
                r["on"] |= on
        else:
            r = block.setdefault(host, {"types": set(), "all": False, "third": True})
            r["all"] |= not types
            r["types"] |= types
            r["third"] &= third
    out = []
    for h, r in sorted(block.items()):
        out.append("b " + h + (" 3" if r["third"] else "") + ("" if r["all"] else " t=" + ",".join(sorted(r["types"]))))
    for h, r in sorted(allow.items()):
        out.append("a " + h + ("" if r["all"] else " t=" + ",".join(sorted(r["types"])))
                   + ("" if r["everywhere"] else " on=" + ",".join(sorted(r["on"]))))
    out += ["s " + h for h in sorted(site)]
    return out, len(block), len(allow), len(site)


def cmd_web_filters():
    src = os.path.join(ROOT, "downloads", "filters")
    lines, head = [], []
    for name in ("easylist.txt", "easyprivacy.txt"):
        path = os.path.join(src, name)
        fetch(f"https://easylist.to/easylist/{name}", path)
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read().splitlines()
        version = next((l.split(":", 1)[1].strip() for l in text[:20] if l.startswith("! Version:")), "?")
        head.append(f"{name[:-4]} {version}")
        lines += text
    out, nb, na, ns = compile_filters(lines)
    built = os.path.join(src, "filters.txt")
